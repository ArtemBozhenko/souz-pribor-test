# Провайдер LLM: anthropic (формат /v1/messages) или openai-compatible (формат /chat/completions)
LLM_PROVIDER=anthropic
# Базовый URL API. Пусто — адрес провайдера по умолчанию. Для OpenCode Zen: https://opencode.ai/zen/v1
LLM_BASE_URL=
# Модель. По умолчанию claude-sonnet-5-5
LLM_MODEL=claude-sonnet-5-5
# Ключ API. Не коммитить. Без ключа работает только заглушка
LLM_API_KEY=
# Порт сервера Fastify (Vite в режиме dev проксирует /api на него)
PORT=3000
