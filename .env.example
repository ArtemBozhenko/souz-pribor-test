# Провайдер LLM: anthropic (формат /v1/messages) или openai-compatible (формат /chat/completions)
LLM_PROVIDER=anthropic
# Базовый URL API. Пусто — адрес провайдера по умолчанию (api.anthropic.com / api.openai.com)
LLM_BASE_URL=
# Модель. По умолчанию claude-sonnet-5-5
LLM_MODEL=claude-sonnet-5-5
# Модели для выбора в интерфейсе, API (поле model) и CLI (--model), через запятую.
# Все работают через того же провайдера и ключ. Пусто — доступна только LLM_MODEL.
# Неизвестная модель в запросе — ошибка 400 unsupported_model, без подмены.
LLM_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
# Ключ API. Не коммитить. Без ключа отдаётся статичная заглушка (удобно для проверки интерфейса)
LLM_API_KEY=
# Только для anthropic: output_config.effort — low | medium | high. Пусто — не передаётся
LLM_EFFORT=
# Structured outputs (JSON-схема ответа): auto | on | off.
# auto — включено для anthropic, выключено для openai-compatible (поддержка json_schema у GLM/Kimi/Qwen неравномерна)
LLM_STRUCTURED=auto
# Порт сервера Fastify (Vite в режиме dev проксирует /api на него)
PORT=3000

# Варианты провайдера (раскомментировать один блок):
#
# 1. OpenCode Zen, Claude (формат Anthropic; хвост /v1 адаптер срезает сам)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
#
# 2. OpenCode Zen, остальные модели (GLM, Kimi, Qwen и т. п.)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=<id модели из каталога Zen>
# LLM_MODELS=<id 1>,<id 2>
#
# 3. Anthropic напрямую
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
#
# 4. Z.ai (бесплатная glm-4.5-flash, жёсткий лимит запросов — возможны 429)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.z.ai/api/anthropic
# LLM_MODEL=glm-4.5-flash
#   или через /chat/completions:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-4.5-flash
